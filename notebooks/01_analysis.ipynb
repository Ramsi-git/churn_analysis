  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Task 2 — Data Cleaning & Leakage-Safe Preprocessing\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df['TotalCharges'] = pd.to_numeric(df['TotalCharges'], errors='coerce')\n",
    "\n",
    "blank_totalcharges = int(df['TotalCharges'].isna().sum())\n",
    "zero_tenure_among_blanks = int(\n",
    "    (df.loc[df['TotalCharges'].isna(), 'tenure'] == 0).sum()\n",
    ")\n",
    "\n",
    "print('Blank TotalCharges:', blank_totalcharges)\n",
    "print('Blank TotalCharges with tenure = 0:', zero_tenure_among_blanks)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# The 11 blank TotalCharges records correspond to zero-tenure customers.\n",
    "# They are retained and assigned 0.0 rather than dropped.\n",
    "df.loc[df['TotalCharges'].isna(), 'TotalCharges'] = 0.0\n",
    "\n",
    "print('Remaining TotalCharges missing values:', df['TotalCharges'].isna().sum())\n",
    "print('Rows dropped:', 0)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Feature preparation\n",
    "\n",
    "- Remove `customerID` because it is an identifier.\n",
    "- Separate `Churn` as the target.\n",
    "- Numeric variables: `SeniorCitizen`, `tenure`, `MonthlyCharges`, `TotalCharges`.\n",
    "- Categorical variables: one-hot encoded.\n",
    "- Numeric variables: standardized.\n",
    "- The preprocessing transformer is fitted on training data only.\n",
    "\n",
    "The LLM governance layer separately prevents raw demographic/family attributes from being passed as explanations.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "target = 'Churn'\n",
    "identifier = 'customerID'\n",
    "\n",
    "y = (df[target] == 'Yes').astype(int)\n",
    "features = [c for c in df.columns if c not in [identifier, target]]\n",
    "X = df[features].copy()\n",
    "\n",
    "numeric_features = ['SeniorCitizen', 'tenure', 'MonthlyCharges', 'TotalCharges']\n",
    "categorical_features = [c for c in features if c not in numeric_features]\n",
    "\n",
    "print('Numeric features:', numeric_features)\n",
    "print('Categorical feature count:', len(categorical_features))\n",
    "print('Model features before encoding:', X.shape[1])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y,\n",
    "    test_size=0.20,\n",
    "    random_state=42,\n",
    "    stratify=y\n",
    ")\n",
    "\n",
    "train_preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\n",
    "            'numeric',\n",
    "            Pipeline([\n",
    "                ('imputer', SimpleImputer(strategy='median')),\n",
    "                ('scaler', StandardScaler())\n",
    "            ]),\n",
    "            numeric_features\n",
    "        ),\n",
    "        (\n",
    "            'categorical',\n",
    "            Pipeline([\n",
    "                ('imputer', SimpleImputer(strategy='most_frequent')),\n",
    "                ('onehot', OneHotEncoder(handle_unknown='ignore', sparse_output=False))\n",
    "            ]),\n",
    "            categorical_features\n",
    "        )\n",
    "    ]\n",
    ")\n",
    "\n",
    "X_train_processed = train_preprocessor.fit_transform(X_train)\n",
    "X_test_processed = train_preprocessor.transform(X_test)\n",
    "feature_names = train_preprocessor.get_feature_names_out()\n",
    "\n",
    "print('Training rows:', X_train_processed.shape[0])\n",
    "print('Test rows:', X_test_processed.shape[0])\n",
    "print('Processed feature count:', len(feature_names))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Task 3 — Predictive Modelling\n",
    "\n",
    "Compare Logistic Regression and Random Forest.\n",
    "\n",
    "**Selection rule:** 5-fold cross-validation F1-score on the training data. The test set is reserved for final evaluation.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "logistic_model = LogisticRegression(max_iter=2000, random_state=42)\n",
    "\n",
    "random_forest_model = RandomForestClassifier(\n",
    "    n_estimators=300,\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "lr_cv_f1 = cross_val_score(\n",
    "    logistic_model,\n",
    "    X_train_processed,\n    "    y_train,\n    "    cv=cv,\n    "    scoring='f1',\n    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "rf_cv_f1 = cross_val_score(\n",
    "    random_forest_model,\n    "    X_train_processed,\n    "    y_train,\n    "    cv=cv,\n    "    scoring='f1',\n    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "print(f'Logistic Regression CV F1: {lr_cv_f1.mean():.4f} ± {lr_cv_f1.std():.4f}')\n",
    "print(f'Random Forest CV F1:        {rf_cv_f1.mean():.4f} ± {rf_cv_f1.std():.4f}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "logistic_model.fit(X_train_processed, y_train)\n",
    "random_forest_model.fit(X_train_processed, y_train)\n",
    "\n",
    "models = {\n",
    "    'Logistic Regression': logistic_model,\n",
    "    'Random Forest': random_forest_model\n",
    "}\n",
    "\n",
    "results = []\n",
    "\n",
    "for name, model in models.items():\n",
    "    train_pred = model.predict(X_train_processed)\n",
    "    test_pred = model.predict(X_test_processed)\n",
    "    test_prob = model.predict_proba(X_test_processed)[:, 1]\n",
    "\n",
    "    results.append({\n",
    "        'Model': name,\n",
    "        'Test Accuracy': accuracy_score(y_test, test_pred),\n",
    "        'Test Precision': precision_score(y_test, test_pred, zero_division=0),\n",
    "        'Test Recall': recall_score(y_test, test_pred, zero_division=0),\n",
    "        'Test F1': f1_score(y_test, test_pred, zero_division=0),\n",
    "        'Test ROC-AUC': roc_auc_score(y_test, test_prob),\n",
    "        'Train Accuracy': accuracy_score(y_train, train_pred)\n",
    "    })\n",
    "\n",
    "results_df = pd.DataFrame(results).set_index('Model')\n",
    "results_df['Train-Test Accuracy Gap'] = (\n",
    "    results_df['Train Accuracy'] - results_df['Test Accuracy']\n",
    ")\n",
    "\n",
    "display(results_df)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Preserve the required project variables.\n",
    "best_model = random_forest_model\n",
    "best_model_name = 'Random Forest'\n",
    "\n",
    "rf_train_pred = best_model.predict(X_train_processed)\n",
    "rf_test_pred = best_model.predict(X_test_processed)\n",
    "rf_test_prob = best_model.predict_proba(X_test_processed)[:, 1]\n",
    "\n",
    "rf_metrics = {\n",
    "    'Test accuracy': accuracy_score(y_test, rf_test_pred),\n",
    "    'Test precision': precision_score(y_test, rf_test_pred, zero_division=0),\n",
    "    'Test recall': recall_score(y_test, rf_test_pred, zero_division=0),\n",
    "    'Test F1': f1_score(y_test, rf_test_pred, zero_division=0),\n",
    "    'Test ROC-AUC': roc_auc_score(y_test, rf_test_prob),\n",
    "    'Train accuracy': accuracy_score(y_train, rf_train_pred)\n",
    "}\n",
    "\n",
    "rf_metrics['Train-test accuracy gap'] = (\n",
    "    rf_metrics['Train accuracy'] - rf_metrics['Test accuracy']\n",
    ")\n",
    "\n",
    "for k, v in rf_metrics.items():\n",
    "    print(f'{k}: {v:.4f}')\n",
    "\n",
    "print('\\nConfusion matrix:')\n",
    "print(confusion_matrix(y_test, rf_test_pred))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Recorded project results for the September 6, 2026 test\n",
