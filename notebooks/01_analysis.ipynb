    "}\n",
    "\n",
    "def retrieve_retention_clause(risk_probability, tenure):\n",
    "    if tenure < 3:\n",
    "        return 'clause_3', retention_playbook['clause_3']\n",
    "    if risk_probability >= 0.70:\n",
    "        return 'clause_1', retention_playbook['clause_1']\n",
    "    if 0.40 <= risk_probability < 0.70:\n",
    "        return 'clause_2', retention_playbook['clause_2']\n",
    "    return None, None\n"
